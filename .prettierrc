{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "content/posts/**/*.mdx",
      "options": {
        "printWidth": 75,
        "proseWrap": "preserve"
      }
    }
  ]
}
